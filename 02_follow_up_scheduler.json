    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst toIST = (d) => new Date(d.getTime() + 330 * 60000).toISOString().replace(/\\.\\d{3}Z$/, '+05:30');\n\nconst MAX_PER_RUN = 15;               // Telegram group chats allow ~20 messages/minute\nconst ELIGIBLE_STATUSES = ['new'];    // add e.g. 'contacted' here if you want reminders for other statuses\nconst now = Date.now();\nconst stamp = toIST(new Date());\nconst stats = { read: 0, notDue: 0, alreadyReminded: 0, ineligibleStatus: 0, badDate: 0, noRowNumber: 0 };\nconst due = [];\n\nfor (const it of $input.all()) {\n  const r = it.json;\n  if (!r || !r['Lead ID']) continue;\n  stats.read++;\n  if (r.row_number === undefined || r.row_number === null || r.row_number === '') { stats.noRowNumber++; continue; }\n  if (!ELIGIBLE_STATUSES.includes(String(r['Status'] || '').trim().toLowerCase())) { stats.ineligibleStatus++; continue; }\n  if (String(r['Follow-up Reminder Sent'] || '').trim()) { stats.alreadyReminded++; continue; }\n  const raw = String(r['Follow-up At'] || '').trim();\n  const t = raw ? Date.parse(raw) : NaN;\n  if (isNaN(t)) { stats.badDate++; continue; }\n  if (t > now) { stats.notDue++; continue; }\n  due.push({ t, r });\n}\ndue.sort((a, b) => a.t - b.t);\n\nreturn due.slice(0, MAX_PER_RUN).map(({ r }) => ({ json: {\n  row_number: Number(r.row_number), leadId: r['Lead ID'], reminderStamp: stamp, stats,\n  message: ['⏰ Follow-up reminder', 'Name: ' + (r['Name'] || '-'), 'Email: ' + (r['Email'] || '-'), 'Phone: ' + (r['Phone'] || '-'),\n    'Company: ' + (r['Company'] || '-'), 'Source: ' + (r['Source'] || '-'), 'Requirement: ' + (r['Requirement'] || '-'),\n    'Assigned to: ' + (r['Assigned To'] || '-'), 'Follow-up was due: ' + (r['Follow-up At'] || '-'),\n    'Lead ID: ' + r['Lead ID'], 'Status is still New - please contact this lead.'].join('\\n') } }));\n"
      },
      "id": "9bc04f2c-825d-4d7d-a4f7-0e0c4e812035",
