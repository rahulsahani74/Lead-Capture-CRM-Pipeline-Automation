    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst toIST = (d) => new Date(d.getTime() + 330 * 60000).toISOString().replace(/\\.\\d{3}Z$/, '+05:30');\n\nconst cfg = $('Config').first().json;\nconst lead = $('Validate & Normalize').first().json.lead;\nconst now = new Date();\nconst nowIST = toIST(now);\nconst followUpHours = Number(cfg.followUpHours) > 0 ? Number(cfg.followUpHours) : 24;\n\nconst rows = $input.all().map(i => i.json).filter(r => r && r.row_number !== undefined && (r['Lead ID'] || r['Email'] || r['Phone']));\nconst normEmail = s => String(s || '').trim().toLowerCase();\nconst phoneKeyOf = s => String(s || '').replace(/\\D/g, '');\n\nlet match = null, matchType = 'none', ambiguous = false;\nif (lead.email) {\n  const byEmail = rows.filter(r => normEmail(r['Email']) === lead.email);\n  if (byEmail.length) { match = byEmail[0]; matchType = 'email'; }\n  else if (lead.phoneKey) {\n    // Same phone on a row that has NO email: unambiguous enrichment only\n    const p = rows.filter(r => !normEmail(r['Email']) && phoneKeyOf(r['Phone']) === lead.phoneKey);\n    if (p.length === 1) { match = p[0]; matchType = 'phone-enrich'; }\n    else if (p.length > 1) ambiguous = true;\n  }\n} else if (lead.phoneKey) {\n  const p = rows.filter(r => phoneKeyOf(r['Phone']) === lead.phoneKey);\n  if (p.length === 1) { match = p[0]; matchType = 'phone'; }\n  else if (p.length > 1) ambiguous = true;\n}\n\nconst extraText = Object.keys(lead.extra || {}).length\n  ? 'Extra: ' + Object.entries(lead.extra).map(([k, v]) => `${k}=${v}`).join('; ') : '';\nconst field = (label, v) => `${label}: ${v || '-'}`;\n\nif (match) {\n  if (typeof match.row_number !== 'number' && !/^\\d+$/.test(String(match.row_number))) {\n    throw new Error('Google Sheets read did not return a usable row_number');\n  }\n  const oldNotes = String(match['Notes'] || '');\n  const note = `[${nowIST}] Repeat inquiry via ${lead.source}` + (lead.requirement ? `: ${lead.requirement}` : '') + (extraText ? ` (${extraText})` : '');\n  const notes = (oldNotes ? oldNotes + '\\n' : '') + note;\n  const update = {\n    row_number: Number(match.row_number),\n    'Name': match['Name'] || lead.name,\n    'Email': match['Email'] || lead.email,\n    'Phone': match['Phone'] || lead.phone,\n    'Company': match['Company'] || lead.company,\n    'Requirement': match['Requirement'] || lead.requirement,\n    'Notes': notes.slice(-5000)\n  };\n  const status = match['Status'] || 'New';\n  return [{ json: { action: 'updated', matchType, leadId: match['Lead ID'] || '', update,\n    duplicateMessage: ['♻️ Repeat inquiry (existing lead updated)', field('Name', update['Name']), field('Email', update['Email']),\n      field('Phone', update['Phone']), field('Source (this time)', lead.source), field('Requirement', lead.requirement),\n      field('Current status', status), 'Status was NOT reset.'].join('\\n') } }];\n}\n\n// New lead\nconst existingIds = new Set(rows.map(r => String(r['Lead ID'] || '')));\nlet leadId;\ndo {\n  leadId = 'LD-' + nowIST.slice(0, 10).replace(/-/g, '') + '-' + Math.random().toString(36).slice(2, 8).toUpperCase();\n} while (existingIds.has(leadId));\n\nconst notesParts = [];\nif (ambiguous) notesParts.push('Review: phone matches more than one existing row; created as a new lead.');\nif (extraText) notesParts.push(extraText);\n\nconst row = {\n  'Lead ID': leadId, 'Name': lead.name, 'Email': lead.email, 'Phone': lead.phone, 'Company': lead.company,\n  'Requirement': lead.requirement, 'Source': lead.source, 'Status': 'New', 'Assigned To': '',\n  'Created At': nowIST, 'Follow-up At': toIST(new Date(now.getTime() + followUpHours * 3600000)),\n  'Last Contacted': '', 'Notes': notesParts.join('\\n'), 'Follow-up Reminder Sent': ''\n};\nreturn [{ json: { action: 'created', matchType, leadId, row,\n  newLeadMessage: ['🔔 New lead', field('Name', row['Name']), field('Email', row['Email']), field('Phone', row['Phone']),\n    field('Company', row['Company']), field('Source', row['Source']), field('Requirement', row['Requirement']),\n    field('Status', row['Status']), field('Lead ID', leadId), 'Follow up by: ' + row['Follow-up At'],\n    'Reminder: contact this lead soon and update Status in the Leads sheet.'].join('\\n') } }];\n"
      },
