    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst toIST = (d) => new Date(d.getTime() + 330 * 60000).toISOString().replace(/\\.\\d{3}Z$/, '+05:30');\n\nconst LIMITS = { name: 120, email: 254, phone: 32, company: 160, requirement: 2000, source: 80 };\nconst KNOWN = ['name', 'email', 'phone', 'company', 'requirement', 'source'];\n\nlet body = $input.item.json.body;\nif (typeof body === 'string') {\n  try { body = JSON.parse(body); } catch (e) { body = null; }\n}\nif (!body || typeof body !== 'object' || Array.isArray(body)) {\n  return { json: { valid: false, errors: ['Request body must be a JSON object'] } };\n}\n\nconst errors = [];\nconst clean = (field, v, guardFormula) => {\n  if (v === undefined || v === null) return '';\n  if (typeof v === 'object') { errors.push(`${field} must be a string`); return ''; }\n  let s = String(v).replace(/[\\u0000-\\u001F\\u007F]/g, ' ').replace(/\\s+/g, ' ').trim();\n  if (s.length > LIMITS[field]) { errors.push(`${field} is too long (max ${LIMITS[field]} characters)`); return ''; }\n  if (guardFormula && /^[=+\\-@]/.test(s)) s = \"'\" + s;\n  return s;\n};\n\nconst name = clean('name', body.name, true);\nconst email = clean('email', body.email, false).toLowerCase();\nconst phoneRaw = clean('phone', body.phone, false);\nconst company = clean('company', body.company, true);\nconst requirement = clean('requirement', body.requirement, true);\nconst source = clean('source', body.source, true) || 'Unknown';\n\nif (!name) errors.push('name is required');\nif (!email && !phoneRaw) errors.push('Provide at least one of email or phone');\nif (email && !(/^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(email) && !email.includes('..'))) errors.push('email format is invalid');\n\n// Phone: keep a leading + (or convert a leading 00 to +). Never assume a country code.\nlet phone = '';\nlet phoneKey = '';\nif (phoneRaw) {\n  let digits = phoneRaw.replace(/\\D/g, '');\n  let plus = phoneRaw.startsWith('+');\n  if (!plus && digits.startsWith('00')) { plus = true; digits = digits.slice(2); }\n  if (digits.length < 7 || digits.length > 15 || /[^0-9+\\-\\s().]/.test(phoneRaw)) {\n    errors.push('phone must contain 7-15 digits');\n  } else {\n    phone = (plus ? '+' : '') + digits;\n    phoneKey = digits;\n  }\n}\n\n// Keep extra scalar fields instead of silently dropping them (max 10 keys)\nconst extra = {};\nlet n = 0;\nfor (const k of Object.keys(body)) {\n  if (KNOWN.includes(k) || n >= 10) continue;\n  const v = body[k];\n  if (v === null || typeof v === 'object') continue;\n  const key = String(k).replace(/[^\\w.-]/g, '').slice(0, 40);\n  const val = String(v).replace(/[\\u0000-\\u001F\\u007F]/g, ' ').trim().slice(0, 200);\n  if (key && val) { extra[key] = val; n++; }\n}\n\nif (errors.length) return { json: { valid: false, errors } };\n\nreturn { json: { valid: true, errors: [], receivedAt: toIST(new Date()),\n  lead: { name, email, phone, phoneKey, company, requirement, source, extra } } };\n"
      },
