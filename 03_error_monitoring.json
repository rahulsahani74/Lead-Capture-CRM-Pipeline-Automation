      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst j = $input.first().json;\nconst redact = (s) => String(s || '')\n  .replace(/[\\w.+-]+@[\\w-]+\\.[\\w.-]+/g, '[email]')\n  .replace(/\\+?\\d[\\d\\s().-]{6,}\\d/g, '[number]')\n  .replace(/(bearer|token|key|secret|password)([\\s:=]+)\\S+/ig, '$1$2[redacted]')\n  .replace(/[A-Za-z0-9_\\-]{32,}/g, '[redacted]');\nconst exec = j.execution || {};\nconst wfl = j.workflow || {};\nconst msg = redact(exec.error && exec.error.message).slice(0, 300);\nconst lines = [\n  '⚠️ n8n workflow failed',\n  'Workflow: ' + (wfl.name || 'unknown'),\n  'Failed node: ' + (exec.lastNodeExecuted || 'unknown'),\n  'Mode: ' + (exec.mode || 'unknown'),\n  'Execution ID: ' + (exec.id || 'unknown'),\n  'Error: ' + (msg || 'no message'),\n];\nif (exec.url) lines.push('Open: ' + exec.url);\nreturn [{ json: { message: lines.join('\\n').slice(0, 3500) } }];\n"
      },
